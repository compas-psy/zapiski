<?xml version="1.0" encoding="utf-8"?>
<!--
  Что FileProvider имеет право отдавать наружу.

  Ровно один каталог: `cache/updates`, куда ложится скачанный APK. Ни vault,
  ни ключи биометрии, ни очереди виджетов сюда не попадают — установщику
  пакетов нечего в них делать.
-->
<paths>
    <cache-path name="updates" path="updates/" />
</paths>
