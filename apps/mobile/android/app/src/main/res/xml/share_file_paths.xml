<?xml version="1.0" encoding="utf-8"?>
<!--
  Что `ShareFileProvider` имеет право отдавать наружу.

  Ровно один каталог: `cache/share`, куда на время отправки ложится копия
  картинки из заметки. Ни само хранилище, ни ключи, ни очереди виджетов сюда
  не попадают — мессенджеру в них делать нечего.

  Копия нужна потому, что заметки живут либо в выбранной человеком папке
  (`content://` SAF), либо в приватном каталоге приложения: права на них есть
  только у нас, и получатель по такому адресу не прочитает ничего.
-->
<paths>
    <cache-path name="share" path="share/" />
</paths>
