{
  "name": "@zapiski/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ЗАПИСКИ для Android: тонкая оболочка Tauri 2 Mobile — точка входа и реализация платформенных портов, ни одного экрана",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:overlay": "node scripts/apply-android-overlay.mjs",
    "android:overlay:selftest": "node scripts/apply-android-overlay.mjs --self-test",
    "android:build": "tauri android build",
    "test": "node scripts/apply-android-overlay.mjs --self-test && vitest run",
    "android:kotlin:check": "node scripts/check-kotlin-imports.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@zapiski/app": "workspace:*",
    "@zapiski/core": "workspace:*",
    "@zapiski/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^3.2.7"
  }
}
