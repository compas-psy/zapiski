{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Права главного окна Android-оболочки. Список принципиально короткий: всё, что можно сделать своей командой с проверкой пути, сделано командой, а не выдачей плагину широких прав.",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",

    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",

    "opener:allow-open-url",
    "opener:allow-default-urls",

    "store:default"
  ]
}
