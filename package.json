{
  "name": "zapiski",
  "version": "0.1.0",
  "private": true,
  "description": "ЗАПИСКИ — спокойное приложение для заметок в Markdown",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @zapiski/web build",
    "build:core": "pnpm --filter @zapiski/core build",
    "build:web": "pnpm --filter @zapiski/web build",
    "dev": "pnpm --filter @zapiski/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:tokens": "node scripts/lint-tokens.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.49.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
