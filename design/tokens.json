    "brand": {
      "$description": "Плитка знака сервиса. Гранат здесь литералом, а не var(--accent): бренд не меняется вместе с пользовательским выбором акцента (Р5 — «Гранат везде, включая иконку»).",
      "svc-zapiski-bg": { "$value": "#B5503C" },
      "svc-zapiski-fg": { "$value": "#FBF3E3", "$description": "Дерево внутри знака — цвет взят из самого zapiski.svg, чтобы подложка совпадала с ним пиксель в пиксель" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "«Линии 1px вместо теней · elevation только модалки» (tz/1_Design §2). Поэтому список короткий: поиск, активный сегмент — и модальные слои, которые собираются в tokens.css из скрима темы.",
    "paper": {
      "elev-search": { "$value": "0 6px 22px rgba(56, 52, 46, 0.10)" },
      "elev-segment": { "$value": "0 1px 2px rgba(56, 52, 46, 0.10)" }
    },
    "graphite": {
      "elev-search": { "$value": "0 6px 22px rgba(0, 0, 0, 0.30)" },
      "elev-segment": { "$value": "0 1px 2px rgba(0, 0, 0, 0.30)" }
    },
    "ink": {
      "elev-search": { "$value": "0 6px 22px rgba(0, 0, 0, 0.45)" },
      "elev-segment": { "$value": "0 1px 2px rgba(0, 0, 0, 0.45)" }
    }
  },

  "typography": {
