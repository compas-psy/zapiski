    "status": {
      "$description": "«Ошибки не кричат». Цвет статуса и текст статуса разведены: индикатору хватает 3:1 (WCAG 1.4.11), тексту нужно 4.5:1 — один тон обе роли не обслуживает. Правило пережило смену палитры и осталось от DS-ALIGNMENT §4.",
      "light": {
        "success": { "$value": "#5C8A6E" },
        "success-soft": { "$value": "#E7F0E8" },
        "success-text": { "$value": "#33684A" },
        "warning": { "$value": "#A87C2C", "$description": "Индикатор: 3.18:1 на своей подложке. Прежний #B08430 давал 2.87 и не проходил WCAG 1.4.11" },
        "warning-soft": { "$value": "#F5EBD8" },
        "warning-text": { "$value": "#84601F" },
        "danger": { "$value": "#A85045" },
        "danger-soft": { "$value": "#F6E5E2" },
        "danger-text": { "$value": "#933B31" },
        "info": { "$value": "#4C6B94" },
        "info-soft": { "$value": "#E4EAF2" },
        "info-text": { "$value": "#3D577A" }
      },
      "dark": {
        "success": { "$value": "#7FB894" },
        "success-soft": { "$value": "rgba(127, 184, 148, 0.16)" },
        "success-text": { "$value": "#A9E0C0" },
        "warning": { "$value": "#D6B26A" },
        "warning-soft": { "$value": "rgba(214, 178, 106, 0.16)" },
        "warning-text": { "$value": "#EBCE96" },
        "danger": { "$value": "#D08476" },
        "danger-soft": { "$value": "rgba(208, 132, 118, 0.16)" },
        "danger-text": { "$value": "#F0AFA6" },
        "info": { "$value": "#7C9DC9" },
        "info-soft": { "$value": "rgba(124, 157, 201, 0.16)" },
        "info-text": { "$value": "#B4CCEE" }
      }
    },

    "code": {
      "$description": "Подсветка синтаксиса — пастельная, в тон темы (tz/0_Master §4: код с подсветкой). Комментарий и фон берут третичный текст и поверхность темы — они объявлены алиасами в tokens.css, а не здесь.",
      "light": {
        "code-keyword": { "$value": "#8E7BA3" },
        "code-string": { "$value": "#4E7A5F" },
        "code-number": { "$value": "#946C26" },
        "code-function": { "$value": "#4C6B94" }
