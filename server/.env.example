###############################################################################
# KompasCloud — бэкенд КОМПАС.ЗАПИСКИ
#
# Ни одного секрета в коде: всё, что ниже, читается только из окружения
# (src/config/env.ts, проверка через zod — сервис не стартует с плохим конфигом).
#
# Обязательные переменные: DATABASE_URL, AUTH_SECRET. Остальные имеют
# работоспособные значения по умолчанию.
###############################################################################

# ── Процесс ──────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=production

# ADR-0003 §2: порт 3100. Порт 3000 занят КОМПАС.Дневником, 25 — почтой;
# ни тот, ни другой не трогаются.
PORT=3100
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent
# Содержимого заметок в журнале нет ни на одном уровне, пути — только хешем.
LOG_LEVEL=info

# Кому верить в X-Forwarded-For. Сервис стоит за nginx, поэтому по умолчанию
# доверяется ровно один переход: адрес берётся тот, который проставил nginx.
#   1 (по умолчанию) — один прокси
#   N               — N ближайших прокси
#   10.0.0.1,…      — доверять только этим адресам
#   false           — не верить заголовку вовсе
#   true            — доверять всей цепочке; НЕ СТАВЬТЕ в проде: самый левый
#                     элемент пишет сам клиент, и request.ip становится
#                     значением, которое назначил кто угодно.
TRUST_PROXY=1

# ── База данных ──────────────────────────────────────────────────────────────

# Свой контейнер Postgres без проброса порта на хост (ADR-0003 §4).
# К базе Дневника подключений нет ни одного.
DATABASE_URL=postgresql://zapiski:ПАРОЛЬ@zapiski-postgres:5432/zapiski
DATABASE_POOL_MAX=10

# ── Хранилище блобов ─────────────────────────────────────────────────────────

# Том с зашифрованными байтами. Внутри — файлы, названные по хешу содержимого:
# из листинга каталога нельзя узнать ни одного заголовка заметки.
BLOB_ROOT=/data/blobs

# ── Аутентификация ───────────────────────────────────────────────────────────

# Секрет подписи access-JWT (HS256). Минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
# Смена значения разлогинивает всех — refresh-токены при этом остаются валидны.
AUTH_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_НЕ_КОРОЧЕ_32_СИМВОЛОВ

# Время жизни access-токена, секунды.
AUTH_ACCESS_TTL_SECONDS=900

# Время жизни refresh-токена, секунды (60 дней). Ротируется при каждом обмене.
AUTH_REFRESH_TTL_SECONDS=5184000

# TTL magic-ссылки, секунды. ТЗ §5.5 — 15 минут.
MAGIC_LINK_TTL_SECONDS=900

# Пауза между письмами на один адрес, секунды.
# SCREENS §2: кнопка «Отправить снова» неактивна 60 с.
MAGIC_LINK_COOLDOWN_SECONDS=60

# Публичный адрес API: из него собирается ссылка в письме и адрес /p/:slug.
PUBLIC_BASE_URL=https://zapiski.cmpas.ru

# Куда увести браузер после успешного входа (deep-link приложения).
# Токены уезжают во фрагменте URL — фрагмент не попадает в логи nginx.
# Пусто — эндпоинт отдаёт JSON.
# AUTH_SUCCESS_REDIRECT=zapiski://auth/callback

# ── Почта ────────────────────────────────────────────────────────────────────

# ADR-0003 §7: используем уже работающий на хосте postfix
# (ALLOWED_SENDER_DOMAINS: cmpas.ru). Новых почтовых сервисов не заводим.
# SMS не используется нигде — прямой запрет ТЗ §5.5.
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_SECURE=false
# Релей на этой же машине, личность подтвердить нечем: STARTTLS остаётся,
# но сертификат не проверяется. Нужно для postfix'а, к которому обращаемся по
# имени host.docker.internal — сертификата на такое имя не существует. Для
# релея за пределами машины обязано быть false.
SMTP_LOCAL_RELAY=true
# Локальный postfix обычно без аутентификации — оставьте пустыми.
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=ЗАПИСКИ <zapiski@cmpas.ru>

# ── Яндекс ID (основной путь входа, ТЗ §5.5) ─────────────────────────────────

# Заводится в https://oauth.yandex.ru. Не задано — вход через Яндекс выключен,
# magic-link продолжает работать.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# По умолчанию: ${PUBLIC_BASE_URL}/api/v1/auth/yandex/callback
# YANDEX_REDIRECT_URI=https://zapiski.cmpas.ru/api/v1/auth/yandex/callback

# ── ЮKassa ───────────────────────────────────────────────────────────────────

# Секрет для HMAC-SHA256 по сырому телу уведомления. ОБЯЗАТЕЛЕН: без него
# вебхук отвечает 503 и ничего не применяет. Непроверенное уведомление не
# должно выдавать подписку.
# YOOKASSA_WEBHOOK_SECRET=

# Необязательное дополнительное сужение поверх подписи: сети, из которых
# ЮKassa шлёт уведомления, через запятую. Само по себе оно ничего не
# подтверждает — адрес приходит из X-Forwarded-For и подделывается.
# Актуальный список — в документации ЮKassa, раздел «HTTP-уведомления».
# YOOKASSA_ALLOWED_CIDRS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11/32,77.75.156.35/32,77.75.154.128/25

# Реквизиты магазина — нужны только для создания платежа из API.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# ── Google Play Billing ──────────────────────────────────────────────────────

# Сервисный аккаунт с доступом к Play Developer API. Не задано — эндпоинт
# проверки покупки отвечает 503 (лучше отказ, чем выданная зря подписка).
# GOOGLE_PLAY_PACKAGE_NAME=ru.cmpas.zapiski
# GOOGLE_PLAY_SA_EMAIL=zapiski-billing@проект.iam.gserviceaccount.com
# Приватный ключ в PEM; переносы строк можно записать как \n.
# GOOGLE_PLAY_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Тариф и лимиты ───────────────────────────────────────────────────────────

# ТЗ §7: 10 ГБ на аккаунт.
QUOTA_BYTES=10737418240

# Предел размера одного блоба, байт (64 МБ).
MAX_BLOB_BYTES=67108864

# Предел размера одного CRDT-апдейта, байт (4 МБ).
MAX_CRDT_BYTES=4194304

# Предел размера опубликованной страницы, байт (2 МБ).
MAX_PUBLISHED_BYTES=2097152

# ТЗ §4.2: срок хранения истории версий.
VERSION_RETENTION_TRIAL_DAYS=30
VERSION_RETENTION_PAID_DAYS=365

# SCREENS §9: «Попробовать 14 дней».
TRIAL_DAYS=14

# Льготный период после неудачного продления, дней. Данные при этом остаются
# доступны в любом случае — истечение подписки не блокирует заметки (ТЗ §5.5).
GRACE_DAYS=7

# ТЗ §5.5: 199 ₽/мес, 149 ₽/мес при годовой оплате.
PRICE_MONTHLY_RUB=199
PRICE_YEARLY_MONTHLY_RUB=149

# ── Публикация и обновления ──────────────────────────────────────────────────

# Публикация по ссылке (ТЗ §5.3, P1). false — эндпоинт отвечает 503.
PUBLISH_ENABLED=true

# JSON-манифест автообновлений, который кладёт релизный пайплайн.
# Не задано — фид отвечает 204 («обновления нет»).
# UPDATES_MANIFEST_PATH=/data/updates/latest.json

# ── Прочее ───────────────────────────────────────────────────────────────────

# ТЗ §6: аналитика opt-in. Общий выключатель; согласие каждого пользователя
# хранится отдельно в users.analytics_opt_in.
ANALYTICS_ENABLED=false

# Origin'ы веб-клиента через запятую. Пусто — CORS выключен.
# CORS_ORIGINS=https://zapiski.cmpas.ru
