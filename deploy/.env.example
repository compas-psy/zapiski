# Образец deploy/.env — файла с настройками стека ЗАПИСОК на сервере.
#
# Настоящий deploy/.env лежит ТОЛЬКО на сервере (/var/www/zapiski/deploy/.env),
# в git его нет и быть не должно (.gitignore). Значения ниже — заглушки,
# ни одно из них не является рабочим секретом.
#
# Файл создаётся автоматически при первом запуске
# deploy/deploy-production-remote.sh: он генерирует пароль БД и AUTH_SECRET
# и проставляет почтовые значения по умолчанию. Руками сюда дописывают только
# то, что машина придумать не может.

# ─── Генерируется скриптом деплоя, руками не трогать ─────────────────────────
# Пароль пользователя postgres `zapiski`. Только hex — значение подставляется
# в DATABASE_URL без url-экранирования.
# ВНИМАНИЕ: том zapiski_db_data помнит пароль, с которым база была
# инициализирована. Потерять этот файл, сохранив том, = потерять доступ к базе.
ZAPISKI_DB_PASSWORD=

# HS256-секрет для access-JWT, минимум 32 символа (server/src/config/env.ts).
# Смена секрета разлогинивает всех.
AUTH_SECRET=

# ─── Почта. ADR-0003 §7: существующий postfix КОМПАС.Дневника ───────────────
# 172.17.0.1 — шлюз docker0. Postfix Дневника публикует 25 на хост, а его
# compose-сеть нам недоступна. Если подсеть docker0 другая, поставьте
# host.docker.internal (резолв настроен в docker-compose.yml).
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=25
# Домен обязан быть cmpas.ru — у postfix ALLOWED_SENDER_DOMAINS: cmpas.ru.
EMAIL_FROM=ЗАПИСКИ <zapiski@cmpas.ru>

# ─── Яндекс ID (OAuth). ТЗ §5.5 — основной способ входа ─────────────────────
# Значения приезжают из GitHub Secrets (YANDEX_CLIENT_ID / YANDEX_CLIENT_SECRET)
# при каждом деплое; здесь можно задать вручную, если CI их не передаёт.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://zapiski.cmpas.ru/api/v1/auth/yandex/callback


# ─── Прочее ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
