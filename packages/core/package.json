{
  "name": "@zapiski/core",
  "version": "0.1.0",
  "private": true,
  "description": "Ядро КОМПАС.ЗАПИСКИ: vault, markdown, индекс+FTS, крипто, CRDT, синк, импорт/экспорт, i18n",
  "license": "UNLICENSED",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude test/perf.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hash-wasm": "^4.12.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.0.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
